diff --git a/drivers/thunderbolt/acpi.c b/drivers/thunderbolt/acpi.c
--- a/drivers/thunderbolt/acpi.c
+++ b/drivers/thunderbolt/acpi.c
@@ -8,6 +8,7 @@
 
 #include <linux/acpi.h>
 #include <linux/pm_runtime.h>
